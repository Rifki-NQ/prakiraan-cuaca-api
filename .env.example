# REQUIRED ENVIRONMENT VARIABLE
ETL_DATABASE_URL=postgresql+asyncpg://user:pass@host/neondb?ssl=require

# OPTIONAL ENVIRONMENT VARIABLE.
# Timezone used by the API.
# Defaults to Asia/Jakarta when unset.
# If set, it must be a valid IANA timezone name (e.g. Asia/Jakarta, UTC).
API_TIMEZONE=Asia/Jakarta  # example
# FOR TESTING, should not point to production database
TEST_DATABASE_URL=postgresql+asyncpg://user:pass@host/neondb?ssl=require